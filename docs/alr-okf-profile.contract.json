{
  "okf_version": "0.1",
  "profile": "alr-agent-memory",
  "profile_version": "0.1",
  "description": "Machine-readable OKF-compatible Agent Memory Profile contract for Agent-Lessons-Router bundles.",
  "bundle": {
    "root_marker": ".agent-lessons",
    "bootstrap": {
      "strategy": "find-up",
      "search": "parent-only",
      "fallback": "install-in-current-working-directory",
      "forbidden_discovery_patterns": [
        "recursive-find-from-workspace-root",
        "recursive-find-from-monorepo-root",
        "unbounded-search-outside-agent-lessons"
      ]
    }
  },
  "reserved_index_files": [
    "index.md",
    "index_*.md"
  ],
  "reserved_log_files": [
    "log.md"
  ],
  "concept_roots": [
    {
      "path": "lessons",
      "class": "lesson",
      "required": true,
      "historical_frontmatter_required": false
    },
    {
      "path": "context",
      "class": "context",
      "required": false,
      "historical_frontmatter_required": false
    },
    {
      "path": "repos",
      "class": "repo-guide",
      "required": false,
      "historical_frontmatter_required": false
    },
    {
      "path": "artifacts",
      "class": "artifact",
      "required": false,
      "historical_frontmatter_required": false
    },
    {
      "path": "references",
      "class": "reference",
      "required": false,
      "historical_frontmatter_required": false
    }
  ],
  "archive_roots": [
    "_archive",
    "**/_archive"
  ],
  "required_frontmatter": [
    "type"
  ],
  "recommended_frontmatter": [
    "title",
    "description",
    "tags",
    "timestamp"
  ],
  "concept_defaults": {
    "lesson_type": "Lesson",
    "allow_missing_frontmatter_for_historical_files": true,
    "unknown_types": "preserve-and-treat-as-generic-concepts",
    "unknown_fields": "preserve"
  },
  "alr_extensions": {
    "priority": {
      "type": "string",
      "allowed_values": [
        "P0",
        "P1",
        "P2"
      ],
      "required": false,
      "meaning": "Operational retrieval and Latest Lessons cache importance."
    },
    "domain": {
      "type": "string",
      "required": false,
      "meaning": "Owning ALR routing domain; should match folder and durable sub-index when present."
    },
    "index_home": {
      "type": "string",
      "required": false,
      "meaning": "Durable router home such as index_workspace.md, index_q1.md, or root index.md pinned section."
    },
    "lesson_status": {
      "type": "string",
      "allowed_values": [
        "active",
        "draft",
        "superseded",
        "archived"
      ],
      "required": false,
      "meaning": "Lifecycle state for a lesson concept."
    },
    "supersedes": {
      "type": "array",
      "items": "string",
      "required": false,
      "meaning": "Bundle-relative lesson paths replaced by this lesson."
    },
    "superseded_by": {
      "type": "string",
      "required": false,
      "meaning": "Bundle-relative lesson path that replaces this lesson."
    }
  },
  "index_policy": {
    "root_index": "index.md",
    "domain_subindex_glob": "index_*.md",
    "treat_as_okf_reserved_indexes": true,
    "treat_as_alr_router_indexes": true,
    "concept_frontmatter_required": false,
    "bundle_root_okf_version_frontmatter_allowed": true,
    "routing_authority": "alr-indexes",
    "metadata_must_not_override_router_rows": true,
    "latest_lessons": {
      "role": "recency-cache",
      "system_of_record": false,
      "approx_max_rows": 20,
      "requires_durable_home": true,
      "durable_home_locations": [
        "index_*.md",
        "root-index-pinned-or-cross-cutting-table"
      ],
      "priority_prefixes": [
        "[P0]",
        "[P1]",
        "[P2]"
      ],
      "eviction_order": "oldest-P2-before-P1-or-P0",
      "homogeneous_series_policy": "fold-to-one-subindex-umbrella-row"
    },
    "domain_subindex_homes": {
      "required_for_new_lessons": true,
      "folder_should_match_domain": true,
      "examples": {
        "lessons/workspace": "index_workspace.md",
        "lessons/review": "index_review.md",
        "lessons/q1": "index_q1.md",
        "lessons/g1": "index_g1.md",
        "lessons/d1": "index_d1.md",
        "lessons/_shared": "root-index-pinned-or-cross-cutting-table"
      }
    }
  },
  "retrieval_protocol": {
    "steps": [
      "find-up .agent-lessons",
      "read root index.md",
      "select closest index_*.md or pinned root section",
      "read relevant lesson concept files on demand",
      "prefer P0/P1 and domain-home matches over recency-only cache hits",
      "consult lessons before guessing when blocked or unsure"
    ],
    "progressive_disclosure": true,
    "bounded_search_required": true
  },
  "sop": {
    "review_retrospection": "docs/retro.md",
    "learn": "docs/learn.md",
    "maintain": "docs/maintain.md",
    "preserve_behaviors": [
      "find-up bootstrap",
      "deterministic router indexes",
      "P0/P1/P2 priority",
      "domain sub-index homes",
      "Latest Lessons recency cache",
      "review/retrospection SOP",
      "learn SOP",
      "maintain SOP",
      "consult lessons before guessing"
    ]
  },
  "link_policy": {
    "default_on_broken_internal_links": "warn",
    "strict_mode_on_broken_internal_links": "fail",
    "allow_wiki_links": true,
    "allow_markdown_links": true,
    "consumers_must_tolerate_broken_links": true
  },
  "migration_policy": {
    "historical_files_without_frontmatter": "readable-warning",
    "add_frontmatter_when_touched": true,
    "do_not_flatten_indexes_into_concepts": true,
    "preserve_unknown_fields": true,
    "preserve_unknown_types": true,
    "preserve_router_tables": true,
    "preserve_wiki_links": true,
    "preserve_archives": true
  },
  "secret_policy": {
    "scanners_must_not_print_full_file_bodies_by_default": true,
    "redact_secret_like_values": true,
    "prefer_metadata_paths_headings_and_short_snippets": true
  },
  "tooling_contract": {
    "downstream_tools_must_load_this_contract": true,
    "fail_if_contract_absent_after_dependency_merge": true,
    "round_trip_unknown_fields": "preserve",
    "default_link_check_severity": "warning",
    "strict_link_check_severity": "error"
  }
}
